# SOLEIX authentication setup
# Copy this file to .env.local (or .env) and fill in real values, then run:
#   npm run setup:admin
# The script creates the first Super Admin directly in the database.
# Never commit the filled-in file and never reuse these credentials in frontend code.

SOLEIX_SUPERADMIN_EMAIL=you@soleix.test
SOLEIX_SUPERADMIN_PASSWORD=change-me-to-a-long-secret
SOLEIX_SUPERADMIN_NAME=Head Office

# Optional: keep the SQLite database + uploaded product images outside the repo.
# Defaults to <project>/data
# SOLEIX_DATA_DIR=C:\path\to\soleix-data

# Optional: Google sign-in and customer accounts through Firebase Authentication.
# Leave all of these empty to run with staff-only email/password login.
#
# 1. Web app config — Firebase console → Project settings → Your apps → SDK setup and configuration.
#    These values are public (they ship to the browser), so they must keep the NEXT_PUBLIC_ prefix.
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
# NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef
#
# 2. Admin credentials — server only, never exposed to the browser. Firebase console →
#    Project settings → Service accounts → Generate new private key, then paste the JSON
#    (base64-encoded is also accepted). Alternatively set the three fields below from that JSON.
#    ID tokens and session cookies are verified with this key; without it nobody can sign in
#    with Firebase, and the site falls back to staff-only login.
# FIREBASE_SERVICE_ACCOUNT=eyJwcm9qZWN0X2lkIjoi...
# FIREBASE_PROJECT_ID=your-project
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
#
# In the Firebase console also enable Sign-in method: Email/Password and Google, and add your
# domain (localhost:3000 in development) under Authentication → Settings → Authorized domains.
