# SOLEIX authentication setup
# Copy this file to .env.local (or .env) and fill in real values, then run:
#   npm run setup:admin
# The script creates the first Super Admin directly in the database.
# Never commit the filled-in file and never reuse these credentials in frontend code.

SOLEIX_SUPERADMIN_EMAIL=you@soleix.test
SOLEIX_SUPERADMIN_PASSWORD=change-me-to-a-long-secret
SOLEIX_SUPERADMIN_NAME=Head Office

# Optional: keep the SQLite database + uploaded product images outside the repo.
# Defaults to <project>/data
# SOLEIX_DATA_DIR=C:\path\to\soleix-data

# Optional: Google sign-in ("Login with Google" beside the email/password form).
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials:
#   Application type: Web application
#   Authorized redirect URI: http://localhost:3000/api/auth/google/callback
#   (add your production URL /api/auth/google/callback there too)
# Leave these empty to hide the Google button; email/password login always works.
# Only Google accounts whose verified email already exists as an active staff
# user can sign in — Google never grants a role by itself.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
